# API Key for Anthropic/Gemini
ANTSK_API_KEY=your_api_key_here
# Frontend media proxy endpoint (same-origin backend)
VITE_MEDIA_PROXY_ENDPOINT=/api/media-proxy
VITE_MEDIA_PROXY_ENABLED=true

# new-api account center endpoint
VITE_NEW_API_ENDPOINT=https://api.antsk.cn

# Root `.env` is auto-loaded by the YouTube benchmark proxy/runtime.
# YouTube benchmark downloader override (prefer standalone yt-dlp executable on Windows)
# Example: YOUTUBE_BENCHMARK_YTDLP_BIN=D:\soft\yt-dlp.exe
YOUTUBE_BENCHMARK_YTDLP_BIN=

# Optional legacy fallback to `py -m yt_dlp`.
# Windows defaults to disabled to avoid interpreter-specific module errors.
YOUTUBE_BENCHMARK_ALLOW_PY_FALLBACK=false
